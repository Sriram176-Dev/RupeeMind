# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database: Local MongoDB (View and manage via MongoDB Compass at mongodb://127.0.0.1:27017)
MONGODB_URI=mongodb://127.0.0.1:27017/rupeemind
ML_API_URL=http://127.0.0.1:8000

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_key_change_in_production_32chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production_32chars

# Gemini API for AI Recommendations (Optional free tier key from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Mutual Fund Configuration
MFAPI_BASE_URL=http://api.mfapi.in
RISK_FREE_RATE=0.065
FUND_SYNC_MAX=300
